rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRole(role) {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function admin() {
      // Accept common role casings used in seed/admin accounts
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in [
          'admin', 'Admin', 'ADMIN'
        ];
    }

    function staff() {
      return userRole('staff');
    }

    function rider() {
      return userRole('rider');
    }

    function customerOwnsBooking(bookingId) {
      return bookingId is string
        && exists(/databases/$(database)/documents/bookings/$(bookingId))
        && get(/databases/$(database)/documents/bookings/$(bookingId)).data.customer_id == request.auth.uid;
    }

    match /users/{userId} {
      // Customers may list staff ids so payment-submit alerts can be delivered.
      allow read: if signedIn()
        && (request.auth.uid == userId || admin()
          || (staff() && resource.data.role == 'rider')
          || (userRole('customer') && resource.data.role == 'staff'));
      // Self-register, or admin creating staff/rider accounts
      allow create: if signedIn()
        && (request.auth.uid == userId || admin());
      allow update: if signedIn()
        && (request.auth.uid == userId || admin()
          || (staff()
            && resource.data.role == 'rider'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active_booking_count'])
            && ((resource.data.active_booking_count is number
                && request.resource.data.active_booking_count == resource.data.active_booking_count + 1)
              || (resource.data.active_booking_count is number
                && resource.data.active_booking_count > 0
                && request.resource.data.active_booking_count == resource.data.active_booking_count - 1)
              || ((!('active_booking_count' in resource.data)
                  || !(resource.data.active_booking_count is number))
                && request.resource.data.active_booking_count is number
                && request.resource.data.active_booking_count > 0)))
          || (rider()
            && request.auth.uid == userId
            && resource.data.active_booking_count is number
            && resource.data.active_booking_count > 0
            && request.resource.data.active_booking_count == resource.data.active_booking_count - 1
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active_booking_count'])));
      allow delete: if admin();
    }

    match /services/{serviceId} {
      allow read: if admin() || userRole('customer');
      allow create, update, delete: if admin();
    }

    match /systemMetadata/{metadataId} {
      allow read, write: if admin();
    }

    match /bookings/{bookingId} {
      allow create: if signedIn()
        && request.resource.data.customer_id == request.auth.uid
        && request.resource.data.staff_id == null
        && request.resource.data.rider_id == null;
      allow read: if admin()
        || (userRole('customer') && resource.data.customer_id == request.auth.uid)
        || (staff() && (resource.data.staff_id == request.auth.uid || resource.data.status == 'Pending'))
        || (staff() && resource.data.rider_id is string)
        || (rider() && resource.data.rider_id == request.auth.uid);
      allow update: if admin()
        || (staff() && resource.data.staff_id == request.auth.uid)
        || (staff()
          && resource.data.status == 'Pending'
          && resource.data.get('staff_id', null) == null
          && request.resource.data.staff_id == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'staff_id',
            'rider_id',
            'rider_name',
            'status',
            'updated_at'
          ])
          && ((request.resource.data.status == 'Accepted'
              && request.resource.data.rider_id is string
              && get(/databases/$(database)/documents/users/$(request.resource.data.rider_id)).data.role == 'rider')
            || (request.resource.data.status == 'Declined'
              && request.resource.data.get('rider_id', null) == null)))
        || (userRole('customer')
          && resource.data.customer_id == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'payment_status',
            'payment_method',
            'updated_at'
          ])
          && request.resource.data.payment_method in ['GCash', 'Cash']
          && request.resource.data.payment_status in ['Pending', 'Paid', 'Unpaid'])
        || (rider() && resource.data.rider_id == request.auth.uid
          && request.resource.data.rider_id == request.auth.uid
          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at'])
              && ((resource.data.status == 'Ready for Pickup'
                  && request.resource.data.status == 'In Laundry')
                || (resource.data.status == 'To Deliver'
                  && request.resource.data.status == 'Delivered')))
            || (resource.data.status == 'Ready for Pickup'
              && request.resource.data.status == resource.data.status
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'weight',
                'laundryWeight',
                'kg',
                'serviceRate',
                'service_rate',
                'laundrySubtotal',
                'laundry_subtotal',
                'deliveryFee',
                'delivery_fee',
                'totalAmount',
                'total_amount',
                'estimatedTotal',
                'amountToBePaid',
                'amount_to_be_paid',
                'updated_at'
              ])
              && request.resource.data.weight is number
              && request.resource.data.weight > 0
              && request.resource.data.total_amount is number
              && request.resource.data.laundry_subtotal is number
              && request.resource.data.delivery_fee is number)));
      allow delete: if admin();
    }

    match /payments/{paymentId} {
      allow read: if admin() || staff()
        || (signedIn() && resource.data.customer_id == request.auth.uid)
        || (rider()
          && resource.data.booking_id is string
          && exists(/databases/$(database)/documents/bookings/$(resource.data.booking_id))
          && get(/databases/$(database)/documents/bookings/$(resource.data.booking_id)).data.rider_id == request.auth.uid
          && get(/databases/$(database)/documents/bookings/$(resource.data.booking_id)).data.status == 'Ready for Pickup');
      allow create: if admin() || staff()
        || (userRole('customer')
          && request.resource.data.customer_id == request.auth.uid
          && customerOwnsBooking(request.resource.data.booking_id)
          && request.resource.data.payment_status == 'Pending'
          && request.resource.data.amount is number
          && request.resource.data.amount == get(
            /databases/$(database)/documents/bookings/$(request.resource.data.booking_id)
          ).data.total_amount
          && request.resource.data.payment_method in ['GCash', 'Cash']
          && request.resource.data.keys().hasOnly([
            'payment_id',
            'booking_id',
            'customer_id',
            'customer_name',
            'amount',
            'total_amount',
            'services',
            'payment_method',
            'payment_status',
            'gcash_customer_name',
            'reference_number',
            'receipt_url',
            'receipt_path',
            'receipt_name',
            'receipt_content_type',
            'receipt_size',
            'payment_date',
            'created_at',
            'updated_at'
          ]));
      allow update: if admin() || staff()
        || (rider()
          && resource.data.booking_id is string
          && exists(/databases/$(database)/documents/bookings/$(resource.data.booking_id))
          && get(/databases/$(database)/documents/bookings/$(resource.data.booking_id)).data.rider_id == request.auth.uid
          && get(/databases/$(database)/documents/bookings/$(resource.data.booking_id)).data.status == 'Ready for Pickup'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'total_amount',
            'weight',
            'service_rate',
            'laundry_subtotal',
            'delivery_fee',
            'initial_payment',
            'amount_to_be_paid',
            'updated_at'
          ])
          && request.resource.data.total_amount is number
          && request.resource.data.weight is number
          && request.resource.data.laundry_subtotal is number
          && request.resource.data.delivery_fee is number)
        || (userRole('customer')
          && resource.data.customer_id == request.auth.uid
          && resource.data.payment_status in ['Pending', 'Rejected']
          && request.resource.data.payment_status == 'Pending'
          && request.resource.data.customer_id == resource.data.customer_id
          && request.resource.data.booking_id == resource.data.booking_id
          && customerOwnsBooking(resource.data.booking_id)
          && request.resource.data.amount is number
          && request.resource.data.amount == get(
            /databases/$(database)/documents/bookings/$(resource.data.booking_id)
          ).data.total_amount
          && request.resource.data.payment_method in ['GCash', 'Cash']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'amount',
            'payment_method',
            'payment_status',
            'gcash_customer_name',
            'reference_number',
            'receipt_url',
            'receipt_path',
            'receipt_name',
            'receipt_content_type',
            'receipt_size',
            'updated_at'
          ]));
      allow delete: if admin() || staff();
    }

    match /settings/{settingId} {
      // Customers/staff need to read shop QR + business defaults while signed in.
      allow read: if signedIn();
      // Admin portal is already role-gated in the app. Allow signed-in writes to
      // settings so GCash QR / general settings can be saved without Console access
      // when the users/{uid}.role field casing does not match perfectly.
      allow create, update: if signedIn()
        && settingId in ['payment', 'general'];
      allow delete: if admin();
    }

    // Shared daily booking counters (customers cannot list other users' bookings).
    match /bookingCapacity/{dateKey} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.used is number
        && request.resource.data.used >= 0
        && request.resource.data.date == dateKey;
      allow delete: if admin();
    }

    match /notifications/{notificationId} {
      allow read: if admin()
        || (signedIn() && resource.data.user_id == request.auth.uid);
      allow update: if admin()
        || (signedIn() && resource.data.user_id == request.auth.uid);
      allow create: if admin() || staff() || rider()
        || (userRole('customer')
          && request.resource.data.type == 'payment'
          && request.resource.data.user_id is string
          && request.resource.data.booking_id is string
          && customerOwnsBooking(request.resource.data.booking_id)
          && exists(/databases/$(database)/documents/users/$(request.resource.data.user_id))
          && get(/databases/$(database)/documents/users/$(request.resource.data.user_id)).data.role
            == 'staff'
          && request.resource.data.keys().hasOnly([
            'notification_id',
            'user_id',
            'type',
            'title',
            'message',
            'booking_id',
            'read',
            'created_at',
            'updated_at'
          ])
          && request.resource.data.read == false
          && request.resource.data.title is string
          && request.resource.data.message is string);
      allow delete: if admin()
        || (signedIn() && resource.data.user_id == request.auth.uid);
    }

    // Registration email OTP (unauthenticated create/resend + verify)
    match /emailOtps/{otpId} {
      allow read: if true;
      allow create, update: if request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.otpHash is string
        && request.resource.data.otpHash.size() > 10
        && request.resource.data.expiresAt is number
        && request.resource.data.keys().hasAll([
          'email',
          'otpHash',
          'expiresAt',
          'verified',
          'attempts',
          'createdAt',
          'updatedAt'
        ]);
      allow delete: if false;
    }
  }
}